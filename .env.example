# =============================================================================
# Bharat Market Intelligence Platform - Environment Configuration
# =============================================================================

# Backend Configuration
PROJECT_NAME="Bharat Market Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / Supabase or local SQLite)
DATABASE_URL="sqlite:///./market_intelligence.db"
# For Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Data Providers
# Options: 'yfinance_nse' (Live NSE/BSE feeds via Yahoo Finance) or 'synthetic' (Offline deterministic simulation)
PRIMARY_DATA_PROVIDER="yfinance_nse"
ENABLE_SYNTHETIC_FALLBACK=true
CACHE_EXPIRATION_SECONDS=30

# Indian Market Session Settings (Asia/Kolkata)
TIMEZONE="Asia/Kolkata"
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30

# Risk Management Controls
MAX_RISK_PER_TRADE_PCT=0.005      # 0.5% max capital risk per trade
MAX_PORTFOLIO_EXPOSURE_PCT=0.02   # 2.0% open portfolio risk limit
MAX_DAILY_LOSS_PCT=0.01           # 1.0% daily circuit breaker loss threshold

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
